# ============================================================
# Environment Variables — Elara
# Copy this file to .env.local and fill in the values.
# ============================================================

# ---- Application URL ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
# Legacy SUPABASE_SERVICE_ROLE_KEY is accepted while rotating from older projects.
# Server-only PostgreSQL transaction-pooler connection string (port 6543).
SUPABASE_DB_URL=postgresql://postgres.your-project:password@your-pooler-host.pooler.supabase.com:6543/postgres?sslmode=require

# ---- AI / LLM (optional) ----
# Without this, opportunity extraction uses regex fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ---- Search Providers for Scout (optional — curated registry used if omitted) ----
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ---- Razorpay (optional — checkout disabled until configured) ----
# Get keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to "true" to enable paid checkout
ENABLE_CHECKOUT=false

# ---- Pricing (provisional — $9 for 30 days) ----
# Amount is in the currency's smallest unit (USD cents).
ACCESS_PASS_AMOUNT=900
ACCESS_PASS_CURRENCY=USD
ACCESS_PASS_DURATION_DAYS=30

# ---- AI Allowances ----
FREE_MAX_ANALYSES=5
FREE_MAX_DRAFTS=5
PAID_MAX_ANALYSES=50
PAID_MAX_DRAFTS=50

# ---- Scheduled alerts (required for Vercel cron authorization) ----
CRON_SECRET=

# ---- Email delivery (optional; held until configured) ----
BREVO_API_KEY=
# Use a sender verified in Brevo. SMTP credentials belong in Supabase Auth settings.
EMAIL_FROM=

# Optional server-side token for public contribution issue reads
GITHUB_TOKEN=
